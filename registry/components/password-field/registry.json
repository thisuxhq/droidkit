{
  "name": "password-field",
  "type": "component",
  "description": "Password field that owns show/hide on a 48 dp target, autofill ContentType, IME actions, and error text on the field.",
  "avoidWhen": "Do not use for one-time codes; use otp-input.",
  "status": "draft",
  "states": [
    "default",
    "filled",
    "revealed",
    "error",
    "disabled",
    "rtl",
    "dark",
    "large-font"
  ],
  "files": [
    { "path": "AppPasswordField.kt", "kind": "source" },
    { "path": "AppPasswordFieldPreview.kt", "kind": "preview" },
    { "path": "AppPasswordFieldTest.kt", "kind": "test" }
  ],
  "dependencies": [],
  "registryDependencies": ["theme", "text-field"],
  "platform": "common",
  "minSdk": 24,
  "composeBom": "2026.03.01",
  "themeVersion": 1,
  "experimentalApis": [],
  "accessibility": {
    "talkback": true,
    "dynamicType": true,
    "rtl": true,
    "keyboard": true,
    "touchTarget": true
  },
  "aiHints": [
    "Pass ContentType.NewPassword on sign-up so the provider can suggest a strong password",
    "When isError is true, pass supportingText; color-only errors are rejected",
    "Update isError in the caller on each keystroke; the field does not clear it"
  ],
  "sources": [
    "kb://android/develop/ui/compose/quick-guides/content/show-hide-password",
    "kb://android/develop/ui/compose/text/autofill",
    "kb://android/develop/ui/compose/accessibility/api-defaults",
    "kb://android/develop/ui/compose/components/icon-button",
    "kb://android/develop/ui/compose/state-saving",
    "kb://android/develop/ui/compose/quick-guides/content/validate-input",
    "kb://android/develop/ui/compose/quick-guides/collections/request-user-input"
  ]
}
