    { "path": "AppTextField.kt", "kind": "source" },
    { "path": "AppTextFieldPreview.kt", "kind": "preview" },
    { "path": "AppTextFieldTest.kt", "kind": "test" }
  ],
  "dependencies": [],
  "registryDependencies": ["theme"],
