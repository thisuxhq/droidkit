{
  "name": "otp-input",
  "type": "component",
  "description": "Use for a fixed-length SMS or email one-time code.",
  "avoidWhen": "Do not use for passwords or free-form text; use password-field or text-field.",
  "status": "review",
  "states": [
    "default",
    "partial",
    "filled",
    "disabled",
    "error",
    "rtl",
    "dark",
    "large-font"
  ],
  "files": [
    { "path": "AppOtpInput.kt", "kind": "source" },
    { "path": "AppOtpInputPreview.kt", "kind": "preview" },
    { "path": "AppOtpInputTest.kt", "kind": "test" }
  ],
  "dependencies": [],
  "registryDependencies": ["theme"],
  "platform": "common",
  "minSdk": 24,
  "composeBom": "2026.03.01",
  "themeVersion": 1,
  "experimentalApis": [],
  "accessibility": {
    "talkback": true,
    "dynamicType": true,
    "rtl": true,
    "keyboard": true,
    "touchTarget": true
  },
  "aiHints": [
    "One BasicTextField, not six TextFields",
    "Set ContentType.SmsOtpCode on the single field so SMS autofill works",
    "Keep digit boxes LTR even in an RTL layout",
    "Clear isError on the first onValueChange after a rejected code",
    "Pass onDone — ImeAction.Done does nothing unless the caller wires it"
  ],
  "sources": [
    "kb://android/develop/ui/compose/text/autofill",
    "kb://android/identity/autofill/autofill-optimize",
    "kb://android/develop/ui/compose/accessibility/api-defaults",
    "kb://android/develop/ui/compose/accessibility/semantics",
    "kb://android/develop/ui/compose/accessibility/merging-clearing",
    "kb://android/develop/ui/compose/text/user-input",
    "kb://android/develop/ui/views/touch-and-input/keyboard-input/style"
  ]
}
